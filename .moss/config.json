{
  "version": "9.3.0",
  "project": "/workspace/moss",
  "analysis": {
    "threshold": 50,
    "complexity_threshold": 10,
    "enable_incremental": true,
    "enable_parallel": true,
    "max_workers": 0
  },
  "cache": {
    "l1_size": 1000,
    "l2_ttl": 3600,
    "l3_enabled": true
  },
  "diagnostics": {
    "enabled": true,
    "show_unused_imports": true,
    "show_long_functions": true
  },
  "refactoring": {
    "preview_changes": true,
    "auto_update_imports": true
  }
}